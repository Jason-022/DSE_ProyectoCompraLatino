# Microsoft SQL Server 2022
SQLSERVER_HOST=localhost
SQLSERVER_DATABASE=CompraLatino
SQLSERVER_DRIVER=msnodesqlv8
SQLSERVER_TRUSTED_CONNECTION=true
SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_POOL_MAX=10
SQLSERVER_POOL_MIN=0
SQLSERVER_POOL_IDLE_TIMEOUT=30000
SQLSERVER_CONNECTION_TIMEOUT=15000
SQLSERVER_REQUEST_TIMEOUT=15000

# Para autenticación SQL mediante TCP, usa el controlador predeterminado:
# SQLSERVER_DRIVER=tedious
# SQLSERVER_PORT=1433
# SQLSERVER_USER=compralatino_app
# SQLSERVER_PASSWORD=change_me

# Como alternativa a los campos anteriores, usa una cadena compatible con el controlador elegido:
# SQLSERVER_CONNECTION_STRING=Server=localhost,1433;Database=CompraLatino;User Id=compralatino_app;Password=change_me;Encrypt=false;TrustServerCertificate=true
